{
  "name": "pdi-framework",
  "version": "1.3.7",
  "description": "Portable Device Interface (PDI) framework stack for easy configurable applications running over avr, esp8266, esp32 devices. Designed to easily manage services such as WiFi, HTTP/S, MQTT, SSH server, SFTP, Telnet server, OTA, GPIO, Serial, Time, Crontab, Commandline terminal and much more.",
  "keywords": "iot, wifi, http, https, mqtt, ssh, sftp, telnet, ota, gpio, ntp, cron, shell, terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/Suraj151/pdi-framework.git"
  },
  "authors": [
    {
      "name": "Suraj I.",
      "email": "surajinamdar151@gmail.com",
      "url": "https://github.com/Suraj151",
      "maintainer": true
    }
  ],
  "homepage": "https://github.com/Suraj151/pdi-framework",
  "frameworks": "arduino",
  "platforms": [
    "atmelavr",
    "espressif8266",
    "espressif32"
  ],
  "headers": "PdiStack.h",
  "dependencies": [
    {
      "name": "ESP8266WiFi",
      "platforms": "espressif8266"
    },
    {
      "name": "Networking",
      "platforms": "espressif32"
    },
    {
      "name": "WiFi",
      "platforms": "espressif32"
    },
    {
      "name": "Update",
      "platforms": "espressif32"
    }
  ],
  "build": {
    "libArchive": true
  },
  "export": {
    "include": [
      "src",
      "devices",
      "external",
      "examples",
      "doc",
      "scripts",
      "README.md",
      "LICENSE",
      "keywords.txt",
      "library.properties"
    ],
    "exclude": [
      "scripts/__pycache__"
    ]
  }
}
